{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Android: Build & Deploy (Debug)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/deploy_app.ps1",
                "-Build",
                "-Launch"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Android: Deploy Only (Fast / Sans Rebuild)",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/deploy_app.ps1",
                "-Launch"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Android: Check Connected Devices",
            "type": "shell",
            "command": "C:\\MesProgrammes\\adb-platform-tools\\adb.exe",
            "args": [
                "devices",
                "-l"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android: Build APK Only (assembleDebug)",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": [
                "assembleDebug"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "Android: View Logcat (VarioApp)",
            "type": "shell",
            "command": "C:\\MesProgrammes\\adb-platform-tools\\adb.exe",
            "args": [
                "logcat",
                "-v",
                "time",
                "*:S",
                "VarioService:V",
                "MainActivity:V",
                "AndroidRuntime:E"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
